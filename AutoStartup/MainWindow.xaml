<Window
    x:Class="AutoStartup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AutoStartup.Controls"
    xmlns:converters="clr-namespace:AutoStartup.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:AutoStartup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:AutoStartup.ViewModel"
    Title="服务管理"
    Width="1000"
    Height="600"
    d:DataContext="{d:DesignInstance Type=viewmodel:MainWindowViewModel}"
    Closing="Window_Closing"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <local:StatusColorConverter x:Key="StatusColorConverter" />
        <converters:HalfWindowHeightConverter x:Key="HalfWindowHeightConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <ListBox
                x:Name="ServiceList"
                Grid.Column="0"
                Margin="5,5,5,0"
                dd:DragDrop.IsDragSource="True"
                dd:DragDrop.IsDropTarget="True"
                ItemsSource="{Binding Services}"
                SelectedItem="{Binding SelectedService}"
                SelectionChanged="ServiceList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Margin="3"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            Tag="{Binding}">
                            <Grid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Command="{Binding DeleteCommand}" Header="删除" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal">
                                <Rectangle
                                    Width="7"
                                    Height="7"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Fill="LimeGreen"
                                    RadiusX="100"
                                    RadiusY="100"
                                    Stroke="White"
                                    StrokeThickness="1"
                                    Visibility="{Binding Service.Enabled, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                <Rectangle
                                    Width="7"
                                    Height="7"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Fill="Red"
                                    RadiusX="100"
                                    RadiusY="100"
                                    Stroke="White"
                                    StrokeThickness="1"
                                    Visibility="{Binding Service.Enabled, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                                <TextBlock
                                    Width="{Binding ActualWidth, ElementName=ServiceList}"
                                    Margin="5,0,0,0"
                                    FontWeight="Bold"
                                    Text="{Binding Name}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <Polygon
                                    VerticalAlignment="Center"
                                    Fill="LimeGreen"
                                    Points="1,1 13,7.5 1,14"
                                    Stroke="Black"
                                    StrokeThickness="1"
                                    Visibility="{Binding Running, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                <TextBlock
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="运行中"
                                    Visibility="{Binding Running, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                <Rectangle
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    Fill="Red"
                                    Stroke="Black"
                                    StrokeThickness="1"
                                    Visibility="{Binding Stopped, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                <TextBlock
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="已停止"
                                    Visibility="{Binding Stopped, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                <Path
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource RotateRightGeometry}"
                                    Fill="Magenta"
                                    Stretch="Uniform"
                                    Visibility="{Binding Restarting, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                <TextBlock
                                    Margin="3,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="重启中"
                                    Visibility="{Binding Restarting, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                <Path
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource ErrorGeometry}"
                                    Fill="Red"
                                    Stretch="Uniform"
                                    Visibility="{Binding Error, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                <TextBlock
                                    Margin="3,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="错误"
                                    Visibility="{Binding Error, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    hc:IconElement.Geometry="{StaticResource StartGeometry}"
                                    hc:IconElement.Height="10"
                                    hc:IconElement.Width="10"
                                    Background="{StaticResource PrimaryBrush}"
                                    BorderThickness="0"
                                    Command="{Binding StartCommand}"
                                    Foreground="White"
                                    Style="{StaticResource ButtonIconCircular}" />
                                <Button
                                    Margin="3,0,0,0"
                                    hc:IconElement.Geometry="{StaticResource StopGeometry}"
                                    hc:IconElement.Height="10"
                                    hc:IconElement.Width="10"
                                    Background="{StaticResource DangerBrush}"
                                    BorderThickness="0"
                                    Command="{Binding StopCommand}"
                                    Foreground="White"
                                    Style="{StaticResource ButtonIconCircular}" />
                                <Button
                                    Margin="3,0,0,0"
                                    hc:IconElement.Geometry="{StaticResource RotateRightGeometry}"
                                    BorderThickness="0"
                                    Command="{Binding RestartCommand}"
                                    Style="{StaticResource ButtonIconCircular}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="1" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button
                    Margin="0,0,5,0"
                    HorizontalAlignment="Stretch"
                    Command="{Binding StartAllServiceCommand}"
                    Content="全部启动"
                    Style="{StaticResource ButtonPrimary}" />
                <Button
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Stretch"
                    Command="{Binding StopAllServiceCommand}"
                    Content="全部终止" />
            </Grid>
        </Grid>

        <ScrollViewer Grid.Column="1" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Expander
                    x:Name="ServiceEditor"
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    AllowDrop="True"
                    DragEnter="ServiceEditor_DropEnter"
                    DragLeave="ServiceEditor_DragLeave"
                    Header="编辑服务">
                    <hc:UniformSpacingPanel
                        Margin="10"
                        Orientation="Vertical"
                        Spacing="10">
                        <controls:ControlWithTitle Title="是否启用：" TitleWidth="{StaticResource GlobalTitleWidth}">
                            <ToggleButton
                                Width="40"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding PreviewService.Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ToggleButtonSwitch}" />
                        </controls:ControlWithTitle>
                        <controls:ControlWithTitle Title="名称：" TitleWidth="{StaticResource GlobalTitleWidth}">
                            <TextBox Text="{Binding PreviewService.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:ControlWithTitle>
                        <controls:ControlWithTitle Title="路径：" TitleWidth="{StaticResource GlobalTitleWidth}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PreviewService.FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    Command="{Binding FilePathBrowserCommand}"
                                    Content="浏览"
                                    IsEnabled="{Binding PreviewService, Converter={StaticResource Object2BooleanConverter}}"
                                    Style="{StaticResource ButtonPrimary}" />
                            </Grid>
                        </controls:ControlWithTitle>
                        <controls:ControlWithTitle Title="参数：" TitleWidth="{StaticResource GlobalTitleWidth}">
                            <TextBox Text="{Binding PreviewService.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:ControlWithTitle>
                        <controls:ControlWithTitle Title="工作目录：" TitleWidth="{StaticResource GlobalTitleWidth}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PreviewService.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    Command="{Binding WorkingDirectoryBrowserCommand}"
                                    Content="浏览"
                                    IsEnabled="{Binding PreviewService, Converter={StaticResource Object2BooleanConverter}}"
                                    Style="{StaticResource ButtonPrimary}" />
                            </Grid>
                        </controls:ControlWithTitle>
                        <controls:ControlWithTitle Title="启动前延时 (ms)：" TitleWidth="{StaticResource GlobalTitleWidth}">
                            <TextBox Text="{Binding PreviewService.StartDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:ControlWithTitle>
                        <controls:ControlWithTitle Title="重启前延时 (ms)：" TitleWidth="{StaticResource GlobalTitleWidth}">
                            <TextBox Text="{Binding PreviewService.RestartDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:ControlWithTitle>
                        <controls:ControlWithTitle Title="环境变量：" TitleWidth="{StaticResource GlobalTitleWidth}">
                            <controls:EditableListBox_Dict_String_String ItemSource="{Binding PreviewService.EnvironmentVariables, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:ControlWithTitle>
                        <controls:ControlWithTitle Title="隐藏窗口：" TitleWidth="{StaticResource GlobalTitleWidth}">
                            <ToggleButton
                                Width="40"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding PreviewService.HideWindow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ToggleButtonSwitch}" />
                        </controls:ControlWithTitle>
                        <controls:ControlWithTitle Title="自动重启：" TitleWidth="{StaticResource GlobalTitleWidth}">
                            <ToggleButton
                                Width="40"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding PreviewService.AutoRestart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ToggleButtonSwitch}" />
                        </controls:ControlWithTitle>
                        <controls:ControlWithTitle Title="记录控制台输出：" TitleWidth="{StaticResource GlobalTitleWidth}">
                            <ToggleButton
                                Width="40"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding PreviewService.LogConsoleOutput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ToggleButtonSwitch}" />
                        </controls:ControlWithTitle>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Margin="0,0,5,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ServiceEditCommand}"
                                Content="编辑" />
                            <Button
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ServiceCreateCommand}"
                                Content="新增"
                                Style="{StaticResource ButtonPrimary}" />
                            <Button
                                x:Name="ExtraServiceButton"
                                Grid.Column="2"
                                Margin="5,0,0,0"
                                hc:IconElement.Geometry="{StaticResource AlignHStretchGeometry}"
                                Click="ExtraServiceButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="ExtraServiceButtonMenu">
                                        <MenuItem Header="添加 Python 程序" Tag="PythonProgram" />
                                        <MenuItem Header="添加 Python 模块" Tag="PythonModule" />
                                        <MenuItem Header="添加 cmd 指令" Tag="CMD" />
                                        <MenuItem Header="添加 PowerShell 指令" Tag="PowerShell" />
                                        <MenuItem
                                            Header="添加 Node.JS 程序"
                                            IsEnabled="False"
                                            Tag="NodeJS" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </hc:UniformSpacingPanel>
                </Expander>
                <Expander
                    Grid.Row="1"
                    Margin="0,0,0,5"
                    IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="操作日志" />
                            <TextBlock Text="{Binding SelectedService.OperationLogs.Count, StringFormat=({0} 条)}" />
                        </StackPanel>
                    </Expander.Header>
                    <RichTextBox
                        x:Name="OperationLogDisplay"
                        MaxHeight="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}, Converter={StaticResource HalfWindowHeightConverter}}"
                        FontFamily="Consolas, Microsoft YaHei, 微软雅黑"
                        VerticalScrollBarVisibility="Visible" />
                </Expander>
                <Expander Grid.Row="2" IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="控制台输出" />
                            <TextBlock Text="{Binding SelectedService.ConsoleOutputs.Count, StringFormat=({0} 条)}" />
                        </StackPanel>
                    </Expander.Header>
                    <RichTextBox
                        x:Name="ConsoleOutputDisplay"
                        MaxHeight="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}, Converter={StaticResource HalfWindowHeightConverter}}"
                        FontFamily="Consolas, Microsoft YaHei, 微软雅黑"
                        VerticalScrollBarVisibility="Visible" />
                </Expander>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
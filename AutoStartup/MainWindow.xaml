<Window
    x:Class="AutoStartup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AutoStartup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:AutoStartup.ViewModel"
    Title="MainWindow"
    Width="1000"
    Height="600"
    d:DataContext="{d:DesignInstance Type=viewmodel:MainWindowViewModel}"
    Closing="Window_Closing"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <local:StatusColorConverter x:Key="StatusColorConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--  服务列表  -->
        <ListBox
            Grid.Column="0"
            ItemsSource="{Binding Services}"
            SelectedItem="{Binding SelectedService}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="3" Orientation="Horizontal">
                        <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                        <TextBlock Foreground="Gray" Text=" [" />
                        <TextBlock Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}" Text="{Binding Status}" />
                        <TextBlock Foreground="Gray" Text="]" />
                        <Button
                            Margin="5,0"
                            Command="{Binding StartCommand}"
                            Content="启动" />
                        <Button
                            Margin="5,0"
                            Command="{Binding StopCommand}"
                            Content="停止" />
                        <Button
                            Margin="5,0"
                            Command="{Binding RestartCommand}"
                            Content="重启" />
                        <Button
                            Margin="5,0"
                            Command="{Binding DeleteCommand}"
                            Content="删除" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!--  服务详情  -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <GroupBox
                Grid.Row="0"
                Margin="0,0,0,5"
                Header="操作日志">
                <ListBox
                    FontFamily="Consolas"
                    FontSize="13"
                    ItemsSource="{Binding SelectedService.OperationLogs}" />
            </GroupBox>
            <GroupBox Grid.Row="1" Header="控制台输出">
                <ListBox
                    FontFamily="Consolas"
                    FontSize="13"
                    ItemsSource="{Binding SelectedService.ConsoleOutputs}" />
            </GroupBox>
            <!--  手动添加服务  -->
            <GroupBox
                Grid.Row="2"
                Margin="0,8,0,0"
                Header="手动添加服务">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBox Width="250" Text="{Binding ManualFilePath, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="150" Text="{Binding ManualArguments, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="120" Text="{Binding ManualName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Margin="8,0"
                        Command="{Binding AddManualServiceCommand}"
                        Content="添加服务" />
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>

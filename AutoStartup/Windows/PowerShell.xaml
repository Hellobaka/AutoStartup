<Window
    x:Class="AutoStartup.Windows.PowerShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:AutoStartup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:AutoStartup.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="新增 PowerShell 脚本服务"
    Width="800"
    Loaded="Window_Loaded"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <base:ControlWithTitle Title="PowerShell 指令:" TitleWidth="{StaticResource GlobalTitleWidth}">
                <TextBox x:Name="PowerShellCommand" />
            </base:ControlWithTitle>
        </hc:UniformSpacingPanel>
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="CloseButton"
                Margin="0,0,5,0"
                HorizontalAlignment="Stretch"
                Click="CloseButton_Click"
                Content="关闭" />
            <Button
                x:Name="SaveButton"
                Grid.Column="1"
                Margin="5,0,0,0"
                HorizontalAlignment="Stretch"
                Click="SaveButton_Click"
                Content="保存"
                Style="{StaticResource ButtonPrimary}" />
        </Grid>
    </Grid>
</Window>
